# /etc/soundwaves/env — the service's environment. Owned by root, mode 0600.
# Values are read by systemd, not a shell: no quotes needed, no expansion.

SW_ADDR=127.0.0.1:8090
SW_BASE_URL=https://SW_DOMAIN
SW_DEV=false

# The local Postgres, over the Unix socket, as the service's own role.
SW_DATABASE_URL=postgres:///soundwaves?host=/var/run/postgresql&user=soundwaves

# Identity providers. Create the OAuth applications with these callback URLs:
#   Google (console.cloud.google.com, "OAuth client ID", web application):
#     https://SW_DOMAIN/auth/google/callback
#   GitHub (github.com/settings/developers, "New OAuth App"):
#     https://SW_DOMAIN/auth/github/callback
# A provider left empty is not offered.
SW_GOOGLE_CLIENT_ID=
SW_GOOGLE_CLIENT_SECRET=
SW_GITHUB_CLIENT_ID=
SW_GITHUB_CLIENT_SECRET=

# Quotas.
SW_MAX_PROJECTS=200
SW_MAX_PROJECT_BYTES=1048576
